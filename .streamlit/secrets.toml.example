# Copy this file to secrets.toml and fill in your API keys
# NEVER commit the real secrets.toml to git

APIFY_TOKEN = "apify_api_YOUR_TOKEN_HERE"

# Phase 10 — Provider API keys
ASSEMBLYAI_API_KEY  = "YOUR_ASSEMBLYAI_KEY"   # assemblyai.com — 100 hr/month free
CEREBRAS_API_KEY    = "YOUR_CEREBRAS_KEY"      # cerebras.ai — 1,000 req/day free
VOYAGE_API_KEY      = "YOUR_VOYAGE_KEY"        # voyageai.com — 200M tokens free
GOOGLE_API_KEY      = "YOUR_GOOGLE_KEY"        # aistudio.google.com — 1,500 req/day free
GROQ_API_KEY        = "YOUR_GROQ_KEY"          # console.groq.com — 14,400 req/day free

[providers]
stt        = "assemblyai"  # or "deepgram" to roll back
llm        = "cerebras"    # or "groq" or "openai"
embeddings = "voyage"      # or "openai"
ocr        = "gemini"      # or "none" to disable
generation = "groq"
